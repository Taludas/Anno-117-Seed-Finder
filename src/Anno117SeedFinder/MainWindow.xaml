<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:"
        Title="Anno 117 Seed Finder" Width="1220" Height="920" MinWidth="1040" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#192434"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="Accent" Color="#8A5B24"/>
        <SolidColorBrush x:Key="SiteIcon" Color="#374151"/>
        <ImageBrush x:Key="MountainSiteMask" ImageSource="pack://application:,,,/icons/site_mountain.png" Stretch="Uniform"/>
        <ImageBrush x:Key="RiverSiteMask" ImageSource="pack://application:,,,/icons/site_river.png" Stretch="Uniform"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CDD3DC"/>
            <Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CDD3DC"/><Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C5CBD4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="122"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172337"/><GradientStop Color="#31445B" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="30,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Anno 117 Seed Finder" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [Subtitle], Source={x:Static loc:Localization.Instance}}" Foreground="#CBD5E1" FontSize="13" Margin="1,5,0,0"/>
                </StackPanel>
                <Border x:Name="StartProfilePanel" Grid.Column="1" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [StartHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbStartMode" Width="112" Height="31" Margin="0,4,0,0" SelectedIndex="0" SelectionChanged="StartModeChanged" ToolTip="{Binding [StartModeTooltip], Source={x:Static loc:Localization.Instance}}">
                            <ComboBoxItem Content="{Binding [Flagship], Source={x:Static loc:Localization.Instance}}"/><ComboBoxItem Content="{Binding [StartIsland], Source={x:Static loc:Localization.Instance}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border x:Name="DlcProfilePanel" Grid.Column="2" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [DlcHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Height="31">
                            <CheckBox x:Name="ChkDlc01" Content="DLC01 - PoA" Foreground="White" IsChecked="True" Checked="DlcProfileChanged" Unchecked="DlcProfileChanged" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding [Dlc01Tooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <CheckBox x:Name="ChkDlc03" Content="DLC03 - DotD" Foreground="White" IsChecked="False" IsEnabled="False" Margin="0" VerticalAlignment="Center" ToolTip="{Binding [Dlc03Tooltip], Source={x:Static loc:Localization.Instance}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="LanguagePanel" Grid.Column="3" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [LanguageHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbLanguage" Width="100" Height="31" Margin="0,4,0,0" SelectionChanged="LanguageChanged">
                            <ComboBoxItem Content="{Binding [German], Source={x:Static loc:Localization.Instance}}"/><ComboBoxItem Content="{Binding [EnglishName], Source={x:Static loc:Localization.Instance}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border x:Name="MapProfilePanel" Grid.Column="4" Background="#3A5068" CornerRadius="8" Padding="12,7">
                    <StackPanel><TextBlock Text="{Binding [MapProfileHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox x:Name="CmbMapTemplate" Width="132" Height="31" SelectionChanged="MapProfileChanged" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbMapSize" Width="92" Height="31" SelectionChanged="MapProfileChanged" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFertilitySetting" Width="105" Height="31" SelectedIndex="0" ToolTip="{Binding [FertilitySettingTooltip], Source={x:Static loc:Localization.Instance}}"><ComboBoxItem Content="Abundant"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Sparse"/></ComboBox>
                        </StackPanel>
                        <DockPanel Margin="0,3,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnLoadPreset" Content="{Binding [LoadPreset], Source={x:Static loc:Localization.Instance}}" Click="LoadPreset" Padding="9,3" Margin="0,0,6,0" FontSize="11"/>
                            <Button x:Name="BtnSavePreset" Content="{Binding [SavePreset], Source={x:Static loc:Localization.Instance}}" Click="SavePreset" Padding="9,3" Margin="0" FontSize="11"/>
                        </StackPanel></DockPanel></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <!-- Star-sized (not Auto) so the settings area can never push the buttons or the
                     result table out of the window; it scrolls internally instead. -->
                <RowDefinition Height="1.6*" MinHeight="140" MaxHeight="660"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="150"/>
            </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="226"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
                <Border x:Name="SearchRangeCard" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding [SearchRange], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding [FirstSeed], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtFirstSeed" Grid.Column="1" Text="1" TextChanged="FormatSeedInput" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><Button x:Name="BtnMinSeed" Grid.Column="2" Content="min" Click="SetMinimumSeed" Margin="8,2,0,2" Padding="8,3" ToolTip="{Binding [MinSeedTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <TextBlock Grid.Row="1" Text="{Binding [LastSeed], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtMaxSeed" Grid.Row="1" Grid.Column="1" Text="10000" TextChanged="FormatSeedInput" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><Button x:Name="BtnMaxSeed" Grid.Row="1" Grid.Column="2" Content="max" Click="SetMaximumSeed" Margin="8,2,0,2" Padding="8,3" ToolTip="{Binding [MaxSeedTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <TextBlock Grid.Row="2" Text="{Binding [Threads], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtThreads" Grid.Row="2" Grid.Column="1" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/>
                            <TextBlock Grid.Row="3" Text="{Binding [MaxHits], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtLimit" Grid.Row="3" Grid.Column="1" Text="0" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding [ZeroMeansAll], Source={x:Static loc:Localization.Instance}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="4" Text="{Binding [OutputFile], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtOutput" Grid.Row="4" Grid.Column="1"/><Button Grid.Row="4" Grid.Column="2" Content="{Binding [Browse], Source={x:Static loc:Localization.Instance}}" Click="BrowseOutput" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="CinisCard" Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="28"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                        <TextBlock Text="Cinis" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Slot1], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbSlot1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="*"/><ComboBoxItem Content="Mackerel"/><ComboBoxItem Content="Lavender"/></ComboBox>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [CinisSlotsHeader], Source={x:Static loc:Localization.Instance}}"/><WrapPanel Grid.Column="1" ToolTip="{Binding [CinisSlotsTooltip], Source={x:Static loc:Localization.Instance}}">
                                <CheckBox x:Name="ChkGrapes" Tag="2205" IsChecked="True"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2205.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Grapes"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ChkFlax" Tag="2202"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2202.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Flax"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ChkMurex" Tag="4051"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/4051.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Murex"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ChkOysters" Tag="2208" IsChecked="True"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2208.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Oysters"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ChkSturgeon" Tag="8577" IsChecked="True"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/8577.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Sturgeon"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ChkGold" Tag="32027" IsChecked="True"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/32027.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Gold"/></StackPanel></CheckBox>
                            </WrapPanel>
                        </Grid>
                        <CheckBox x:Name="ChkMaxSites" Grid.Row="3" Content="{Binding [MaxSites], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCinisWarning" Grid.Row="4" Foreground="#C62828" FontSize="12" Visibility="Collapsed" Text="{Binding [CinisWarning], Source={x:Static loc:Localization.Instance}}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="#E4E7EC" BorderThickness="1" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding [AdditionalConditions], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,8"/>
                    <Grid x:Name="ConditionsArea" Grid.Row="1" Margin="4,0,4,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,2,0,10">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [AreaMinimumsHeader], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold"/>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinLatiumArea" VerticalAlignment="Center" ToolTip="{Binding [EnableLatiumArea], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="1" Text="{Binding [TotalAreaLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><Slider x:Name="SldMinLatiumArea" Grid.Column="2" IsEnabled="{Binding IsChecked,ElementName=ChkMinLatiumArea}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" PreviewKeyDown="AreaSliderKeyDown" ValueChanged="AreaSliderValueChanged"/><TextBlock x:Name="LblMinLatiumArea" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button x:Name="BtnLatiumAreaMedian" Grid.Column="4" Content="Median" Click="SelectAreaMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToRoundedMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblLatiumAreaRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinAlbionArea" VerticalAlignment="Center" ToolTip="{Binding [EnableAlbionArea], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="1" Text="{Binding [TotalAreaAlbion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><Slider x:Name="SldMinAlbionArea" Grid.Column="2" IsEnabled="{Binding IsChecked,ElementName=ChkMinAlbionArea}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" PreviewKeyDown="AreaSliderKeyDown" ValueChanged="AreaSliderValueChanged"/><TextBlock x:Name="LblMinAlbionArea" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button x:Name="BtnAlbionAreaMedian" Grid.Column="4" Content="Median" Click="SelectAreaMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToRoundedMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblAlbionAreaRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinAlbionSwampArea" VerticalAlignment="Center" ToolTip="{Binding [EnableAlbionSwampArea], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="1" Text="{Binding [OfWhichSwampAlbion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><Slider x:Name="SldMinAlbionSwampArea" Grid.Column="2" IsEnabled="{Binding IsChecked,ElementName=ChkMinAlbionSwampArea}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" PreviewKeyDown="AreaSliderKeyDown" ValueChanged="AreaSliderValueChanged"/><TextBlock x:Name="LblMinAlbionSwampArea" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button x:Name="BtnAlbionSwampAreaMedian" Grid.Column="4" Content="Median" Click="SelectAreaMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToRoundedMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblAlbionSwampAreaRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Border Height="1" Background="#E4E7EC" Margin="0,12,0,9"/>
                                <TextBlock Text="{Binding [SiteMinimumsHeader], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinLatiumMountainSites" VerticalAlignment="Center" ToolTip="{Binding [EnableLatiumMountainSites], Source={x:Static loc:Localization.Instance}}"/><Rectangle Grid.Column="1" Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Grid.Column="2" Text="{Binding [MountainSitesLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinLatiumMountainSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinLatiumMountainSites}"/><Button x:Name="BtnLatiumMountainSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblLatiumMountainSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinLatiumRiverSites" VerticalAlignment="Center" ToolTip="{Binding [EnableLatiumRiverSites], Source={x:Static loc:Localization.Instance}}"/><Rectangle Grid.Column="1" Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource RiverSiteMask}" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Grid.Column="2" Text="{Binding [RiverSitesLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinLatiumRiverSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinLatiumRiverSites}"/><Button x:Name="BtnLatiumRiverSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblLatiumRiverSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinAlbionMountainSites" VerticalAlignment="Center" ToolTip="{Binding [EnableAlbionMountainSites], Source={x:Static loc:Localization.Instance}}"/><Rectangle Grid.Column="1" Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Grid.Column="2" Text="{Binding [MountainSitesAlbion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinAlbionMountainSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinAlbionMountainSites}"/><Button x:Name="BtnAlbionMountainSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblAlbionMountainSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinGoldSites" VerticalAlignment="Center" ToolTip="{Binding [EnableGoldSites], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/32027.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="Gold"/><TextBlock Grid.Column="2" Text="{Binding [GoldRiverLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinGoldSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinGoldSites}"/><Button x:Name="BtnGoldSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblGoldSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinSturgeonSites" VerticalAlignment="Center" ToolTip="{Binding [EnableSturgeonSites], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/8577.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="Sturgeon"/><TextBlock Grid.Column="2" Text="{Binding [SturgeonRiverLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinSturgeonSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinSturgeonSites}"/><Button x:Name="BtnSturgeonSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblSturgeonSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinGoldMines" VerticalAlignment="Center" ToolTip="{Binding [EnableGoldMines], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/32027.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="Gold"/><TextBlock Grid.Column="2" Text="{Binding [GoldMinesLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinGoldMines" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinGoldMines}"/><Button x:Name="BtnGoldMinesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblGoldMineRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinMarbleSites" VerticalAlignment="Center" ToolTip="{Binding [EnableMarbleSites], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/4062.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="{Binding [RawMarbleIconTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="2" Text="{Binding [MarbleMinesLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinMarbleSites" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinMarbleSites}"/><Button x:Name="BtnMarbleSitesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblMarbleSiteRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinMineralMines" VerticalAlignment="Center" ToolTip="{Binding [EnableMineralMines], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/4053.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="{Binding [MineralsIconTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="2" Text="{Binding [MineralMinesLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinMineralMines" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinMineralMines}"/><Button x:Name="BtnMineralMinesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblMineralMineRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinCopperMines" VerticalAlignment="Center" ToolTip="{Binding [EnableCopperMines], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/4063.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="{Binding [CopperIconTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="2" Text="{Binding [CopperMinesAlbion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinCopperMines" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinCopperMines}"/><Button x:Name="BtnCopperMinesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblCopperMineRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinSilverMines" VerticalAlignment="Center" ToolTip="{Binding [EnableSilverMines], Source={x:Static loc:Localization.Instance}}"/><Image Grid.Column="1" Source="pack://application:,,,/icons/8487.png" Width="22" Height="22" HorizontalAlignment="Left" ToolTip="{Binding [SilverIconTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="2" Text="{Binding [SilverMinesAlbion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbMinSilverMines" Grid.Column="3" IsEnabled="{Binding IsChecked,ElementName=ChkMinSilverMines}"/><Button x:Name="BtnSilverMinesMedian" Grid.Column="4" Content="Median" Click="SelectSiteMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblSilverMineRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#E4E7EC"/>
                        <DockPanel Grid.Row="2" Margin="0,8,0,8">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="LblLatiumProfile" Text="Latium" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                    <Button x:Name="BtnAddLatiumStarter" Content="+ Starter" Tag="Starter" Click="AddLatiumCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddLatiumSecondary" Content="+ Secondary" Tag="Secondary" Click="AddLatiumCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddLatiumTertiary" Content="+ Tertiary" Tag="Tertiary" Click="AddLatiumCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddLatiumAnyCombination" Content="+ Any Combination" Tag="AnyCombination" Click="AddLatiumCondition" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="LatiumConditions"/>
                        </DockPanel>
                        <Border Grid.Row="3" Background="#E4E7EC"/>
                        <DockPanel Grid.Row="4" Margin="0,8,0,4">
                            <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="LblAlbionProfile" Text="Albion" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                    <Button x:Name="BtnAddAlbionStarter" Content="+ Starter" Tag="Starter" Click="AddAlbionCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddAlbionSecondary" Content="+ Secondary" Tag="Secondary" Click="AddAlbionCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddAlbionTertiary" Content="+ Tertiary" Tag="Tertiary" Click="AddAlbionCondition" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAddAlbionAnyCombination" Content="+ Any Combination" Tag="AnyCombination" Click="AddAlbionCondition" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="AlbionConditions"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding [SeedPreview], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="TxtPreviewSeed" Width="120" Text="1" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><Button x:Name="BtnPreview" Content="{Binding [Preview], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" Click="OpenSeedPreview"/><Button x:Name="BtnAddSeedToTable" Content="{Binding [AddToTable], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" Click="AddSeedToResults" ToolTip="{Binding [AddToTableTooltip], Source={x:Static loc:Localization.Instance}}"/></StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="BtnLoadSeedList" Content="{Binding [LoadSeedList], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" Click="LoadSeedList" ToolTip="{Binding [LoadSeedListTooltip], Source={x:Static loc:Localization.Instance}}"/><Button x:Name="BtnExportCsv" Content="{Binding [ExportCsv], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ExportCsv" ToolTip="{Binding [ExportCsvTooltip], Source={x:Static loc:Localization.Instance}}"/><Button x:Name="BtnOpen" Content="{Binding [OpenTxt], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenOutput"/><Button x:Name="BtnCancel" Content="{Binding [Cancel], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CancelSearch"/><Button x:Name="BtnRun" Content="{Binding [StartSearch], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" Click="RunSearch"/></StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <ProgressBar x:Name="SearchProgress" Height="8" Maximum="100" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="LblProgress" Grid.Column="1" Text="{Binding [Ready], Source={x:Static loc:Localization.Instance}}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,2,0,6">
                    <TextBlock Text="{Binding [ColumnsHeader], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkColGoldRiver" Content="{Binding [GoldRiverColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColSturgeon" Content="{Binding [SturgeonRiverColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColGoldMine" Content="{Binding [GoldMinesColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColMarble" Content="{Binding [MarbleMinesColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColMinerals" Content="{Binding [MineralMinesColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColCopper" Content="{Binding [CopperMinesColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <CheckBox x:Name="ChkColSilver" Content="{Binding [SilverMinesColumn], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Checked="ResultColumnsChanged" Unchecked="ResultColumnsChanged"/>
                    <TextBlock Text="{Binding [MultiSortHint], Source={x:Static loc:Localization.Instance}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0" ClipToBounds="True">
                    <DataGrid x:Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC" MouseDoubleClick="PreviewSelectedResult" ToolTip="{Binding [GridTooltip], Source={x:Static loc:Localization.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{Binding [Seed], Source={x:Static loc:Localization.Instance}}" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#9888;" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="{Binding [VerificationTooltip], Source={x:Static loc:Localization.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsVerification}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Seed}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding [LatiumAreaHeader], Source={x:Static loc:Localization.Instance}}" Binding="{Binding LatiumArea}" SortMemberPath="LatiumAreaValue" Width="105"/>
                            <DataGridTextColumn Header="{Binding [AlbionAreaHeader], Source={x:Static loc:Localization.Instance}}" Binding="{Binding AlbionArea}" SortMemberPath="AlbionAreaValue" Width="105"/>
                            <DataGridTextColumn Header="{Binding [SwampAreaHeader], Source={x:Static loc:Localization.Instance}}" Binding="{Binding AlbionSwampArea}" SortMemberPath="AlbionSwampValue" Width="105"/>
                            <DataGridTextColumn Binding="{Binding LatiumMountain}" Width="88">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [MountainSitesInLatiumTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20" Margin="0,0,5,0"/>
                                        <TextBlock Text="Latium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding LatiumRiver}" Width="88">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [RiverSitesInLatiumTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource RiverSiteMask}" Width="20" Height="20" Margin="0,0,5,0"/>
                                        <TextBlock Text="Latium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding AlbionMountain}" Width="88">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [MountainSitesInAlbionTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20" Margin="0,0,5,0"/>
                                        <TextBlock Text="Albion" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="GoldRiverColumn" Binding="{Binding GoldRiverSites}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [GoldRiverSitesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/32027.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource RiverSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="SturgeonRiverColumn" Binding="{Binding SturgeonRiverSites}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [SturgeonRiverSitesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/8577.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource RiverSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="GoldMinesColumn" Binding="{Binding GoldMines}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [GoldMinesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/32027.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="MarbleSitesColumn" Binding="{Binding MarbleSites}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [MarbleSitesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/4062.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="MineralMinesColumn" Binding="{Binding MineralMines}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [MineralMinesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/4053.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="CopperMinesColumn" Binding="{Binding CopperMines}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [CopperMinesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/4063.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="SilverMinesColumn" Binding="{Binding SilverMines}" Width="72" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding [SilverMinesTooltip], Source={x:Static loc:Localization.Instance}}">
                                        <Image Source="pack://application:,,,/icons/8487.png" Width="20" Height="20" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource SiteIcon}" OpacityMask="{StaticResource MountainSiteMask}" Width="20" Height="20"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="CinisResultsColumn" Header="{Binding [CinisFertilitiesHeader], Source={x:Static loc:Localization.Instance}}" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ItemsControl ItemsSource="{Binding CinisFertilities}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="22" Height="22" Margin="0,0,5,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
        </Grid>
    </Grid>
</Window>
