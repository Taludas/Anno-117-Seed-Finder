<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:"
        Title="{x:Static loc:AppVersion.WindowTitle}" Width="1440" Height="900" MinWidth="1180" MinHeight="780"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#192434"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="Accent" Color="#8A5B24"/>
        <SolidColorBrush x:Key="SiteIcon" Color="#374151"/>
        <ImageBrush x:Key="MountainSiteMask" ImageSource="pack://application:,,,/icons/site_mountain.png" Stretch="Uniform"/>
        <ImageBrush x:Key="RiverSiteMask" ImageSource="pack://application:,,,/icons/site_river.png" Stretch="Uniform"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CDD3DC"/>
            <Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CDD3DC"/><Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C5CBD4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter>
        </Style>
        <!-- Applied automatically wherever a ToolTip's content is a RangeGauge (every result-table filter column):
             this seed's value plotted between the 100k-seed population's min and max, with the median marked. -->
        <DataTemplate DataType="{x:Type loc:RangeGauge}">
            <StackPanel Margin="2" Width="210">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                <Grid Height="14" Margin="0,0,0,6">
                    <Border Background="#E4E7EC" CornerRadius="3"/>
                    <Border Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding FillWidth}"/>
                    <Rectangle Width="2" Fill="#374151" HorizontalAlignment="Left" Margin="{Binding MedianMarkerMargin}"/>
                </Grid>
                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="138"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172337"/><GradientStop Color="#31445B" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="24,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="125"/><ColumnDefinition Width="2.5*" MinWidth="458"/><ColumnDefinition Width="0.9*" MinWidth="115"/><ColumnDefinition Width="3.2*" MinWidth="410"/></Grid.ColumnDefinitions>
                <Border x:Name="StartProfilePanel" Grid.Column="0" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [StartHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbStartMode" MinWidth="100" Height="31" Margin="0,4,0,0" SelectedIndex="0" SelectionChanged="StartModeChanged" ToolTip="{Binding [StartModeTooltip], Source={x:Static loc:Localization.Instance}}">
                            <ComboBoxItem Content="{Binding [Flagship], Source={x:Static loc:Localization.Instance}}"/><ComboBoxItem Content="{Binding [StartIsland], Source={x:Static loc:Localization.Instance}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border x:Name="DlcProfilePanel" Grid.Column="1" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [DlcHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Height="31">
                            <CheckBox x:Name="ChkDlc01" Content="DLC01 - PoA" Foreground="White" IsChecked="True" Checked="DlcProfileChanged" Unchecked="DlcProfileChanged" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding [Dlc01Tooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <CheckBox x:Name="ChkDlcRetro" Content="{Binding [DlcRetroLabel], Source={x:Static loc:Localization.Instance}}" Foreground="White" IsChecked="False" Checked="DlcProfileChanged" Unchecked="DlcProfileChanged" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding [DlcRetroTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <CheckBox x:Name="ChkDlc03" Content="DLC03 - DotD" Foreground="White" IsChecked="False" IsEnabled="False" Margin="0" VerticalAlignment="Center" ToolTip="{Binding [Dlc03Tooltip], Source={x:Static loc:Localization.Instance}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="LanguagePanel" Grid.Column="2" Background="#3A5068" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [LanguageHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbLanguage" MinWidth="90" Height="31" Margin="0,4,0,0" SelectionChanged="LanguageChanged">
                            <ComboBoxItem Content="{Binding [German], Source={x:Static loc:Localization.Instance}}"/><ComboBoxItem Content="{Binding [EnglishName], Source={x:Static loc:Localization.Instance}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border x:Name="MapProfilePanel" Grid.Column="3" Background="#3A5068" CornerRadius="8" Padding="12,7">
                    <StackPanel><TextBlock Text="{Binding [MapProfileHeader], Source={x:Static loc:Localization.Instance}}" Foreground="#D6B37A" FontSize="10" FontWeight="Bold"/>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="{Binding [MapTemplateLabel], Source={x:Static loc:Localization.Instance}}" Foreground="#AEBBCB" FontSize="9" FontWeight="SemiBold" Margin="1,0,0,1"/><ComboBox x:Name="CmbMapTemplate" Height="31" SelectionChanged="MapProfileChanged"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="{Binding [MapSizeLabel], Source={x:Static loc:Localization.Instance}}" Foreground="#AEBBCB" FontSize="9" FontWeight="SemiBold" Margin="1,0,0,1"/><ComboBox x:Name="CmbMapSize" Height="31" SelectionChanged="MapProfileChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="{Binding [SlotsLabel], Source={x:Static loc:Localization.Instance}}" Foreground="#AEBBCB" FontSize="9" FontWeight="SemiBold" Margin="1,0,0,1"/><ComboBox x:Name="CmbSlotSetting" Height="31" SelectedIndex="0" ToolTip="{Binding [SlotSettingTooltip], Source={x:Static loc:Localization.Instance}}"><ComboBoxItem Content="Abundant"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Sparse"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="{Binding [FertilityLabel], Source={x:Static loc:Localization.Instance}}" Foreground="#AEBBCB" FontSize="9" FontWeight="SemiBold" Margin="1,0,0,1"/><ComboBox x:Name="CmbFertilitySetting" Height="31" SelectedIndex="0" ToolTip="{Binding [FertilitySettingTooltip], Source={x:Static loc:Localization.Instance}}"><ComboBoxItem Content="Abundant"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Sparse"/></ComboBox></StackPanel>
                        </Grid>
                        <DockPanel Margin="0,3,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnLoadPreset" Content="{Binding [LoadPreset], Source={x:Static loc:Localization.Instance}}" Click="LoadPreset" Padding="9,3" Margin="0,0,6,0" FontSize="11"/>
                            <Button x:Name="BtnSavePreset" Content="{Binding [SavePreset], Source={x:Static loc:Localization.Instance}}" Click="SavePreset" Padding="9,3" Margin="0" FontSize="11"/>
                        </StackPanel></DockPanel></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <!-- Star-sized (not Auto) so the settings area can never push the buttons or the
                     result table out of the window; it scrolls internally instead. -->
                <RowDefinition Height="1.6*" MinHeight="140" MaxHeight="660"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="150"/>
            </Grid.RowDefinitions>
        <ScrollViewer x:Name="FilterScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="290"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
                <Border x:Name="SearchRangeCard" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding [SearchRange], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding [FirstSeed], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtFirstSeed" Grid.Column="1" Text="1" TextChanged="FormatSeedInput" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><Button x:Name="BtnMinSeed" Grid.Column="2" Content="min" Click="SetMinimumSeed" Margin="8,2,0,2" Padding="8,3" ToolTip="{Binding [MinSeedTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <TextBlock Grid.Row="1" Text="{Binding [LastSeed], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtMaxSeed" Grid.Row="1" Grid.Column="1" Text="10000" TextChanged="FormatSeedInput" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><Button x:Name="BtnMaxSeed" Grid.Row="1" Grid.Column="2" Content="max" Click="SetMaximumSeed" Margin="8,2,0,2" Padding="8,3" ToolTip="{Binding [MaxSeedTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            <TextBlock Grid.Row="2" Text="{Binding [Threads], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtThreads" Grid.Row="2" Grid.Column="1" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/>
                            <TextBlock Grid.Row="3" Text="{Binding [MaxHits], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtLimit" Grid.Row="3" Grid.Column="1" Text="0" PreviewTextInput="NumericInputOnly" DataObject.Pasting="NumericPasteOnly"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding [ZeroMeansAll], Source={x:Static loc:Localization.Instance}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="4" Text="{Binding [OutputFile], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><TextBox x:Name="TxtOutput" Grid.Row="4" Grid.Column="1"/><Button Grid.Row="4" Grid.Column="2" Content="{Binding [Browse], Source={x:Static loc:Localization.Instance}}" Click="BrowseOutput" Margin="8,0,0,0"/>
                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="3">
                                <CheckBox x:Name="ChkTableSeeds" VerticalAlignment="Center" Margin="0,5,24,5" IsEnabled="False" Checked="TableSeedsChanged" Unchecked="TableSeedsChanged" ToolTip="{Binding [TableSeedsTooltip], Source={x:Static loc:Localization.Instance}}"/>
                                <CheckBox x:Name="ChkScoring" VerticalAlignment="Center" Margin="0,5,0,5" Checked="ScoringChanged" Unchecked="ScoringChanged" Content="{Binding [EnableScoring], Source={x:Static loc:Localization.Instance}}" ToolTip="{Binding [EnableScoringTooltip], Source={x:Static loc:Localization.Instance}}"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="CinisCard" Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="28"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                        <TextBlock Text="Cinis" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Slot1], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><ComboBox x:Name="CmbSlot1" Grid.Column="1" SelectedIndex="0" SelectionChanged="Slot1Changed"><ComboBoxItem Content="*"/><ComboBoxItem Content="Mackerel"/><ComboBoxItem Content="Lavender"/></ComboBox><Slider x:Name="WgtCinisSlot1" Grid.Column="2" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="56" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisSlot1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [CinisSlotsHeader], Source={x:Static loc:Localization.Instance}}"/><WrapPanel Grid.Column="1" ToolTip="{Binding [CinisSlotsTooltip], Source={x:Static loc:Localization.Instance}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkGrapes" Tag="2205" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2205.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Grapes"/></StackPanel></CheckBox><Slider x:Name="WgtCinisGrapes" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisGrapes" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkFlax" Tag="2202" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2202.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Flax"/></StackPanel></CheckBox><Slider x:Name="WgtCinisFlax" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisFlax" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkMurex" Tag="4051" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/4051.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Murex"/></StackPanel></CheckBox><Slider x:Name="WgtCinisMurex" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisMurex" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkOysters" Tag="2208" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/2208.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Oysters"/></StackPanel></CheckBox><Slider x:Name="WgtCinisOysters" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisOysters" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkSturgeon" Tag="8577" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/8577.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Sturgeon"/></StackPanel></CheckBox><Slider x:Name="WgtCinisSturgeon" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisSturgeon" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><CheckBox x:Name="ChkGold" Tag="32027" Width="95" HorizontalContentAlignment="Left" Margin="0,5,0,5"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/icons/32027.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Gold"/></StackPanel></CheckBox><Slider x:Name="WgtCinisGold" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisGold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                            </WrapPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal"><CheckBox x:Name="ChkMaxSites" Content="{Binding [MaxSites], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><Slider x:Name="WgtCinisMaxSites" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="50" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtCinisMaxSites" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></StackPanel>
                        <TextBlock x:Name="TxtCinisWarning" Grid.Row="4" Foreground="#C62828" FontSize="12" Visibility="Collapsed" Text="{Binding [CinisWarning], Source={x:Static loc:Localization.Instance}}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="#E4E7EC" BorderThickness="1" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding [AdditionalConditions], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,8"/>
                    <CheckBox x:Name="ChkAdvancedCard" Grid.Row="1" Margin="8,0,0,10" Content="{Binding [ShowAdvancedFilters], Source={x:Static loc:Localization.Instance}}" ToolTip="{Binding [ShowAdvancedFiltersTooltip], Source={x:Static loc:Localization.Instance}}" IsChecked="{Binding IsChecked, ElementName=ChkAdvanced, Mode=TwoWay}"/>
                    <Grid x:Name="ConditionsArea" Grid.Row="2" Margin="4,0,4,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,2,0,10">
                            <StackPanel HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                                <TextBlock Text="{Binding [AreaMinimumsHeader], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold"/>
                                <Grid x:Name="AreaWeightHeader" Visibility="Collapsed" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto" SharedSizeGroup="AreaRangeLabel"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="{Binding [WeightColumnHeader], Source={x:Static loc:Localization.Instance}}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="14,0,0,0" ToolTip="{Binding [WeightColumnHeaderTooltip], Source={x:Static loc:Localization.Instance}}"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto" SharedSizeGroup="AreaRangeLabel"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMinLatiumArea" VerticalAlignment="Center" Margin="0" ToolTip="{Binding [EnableLatiumArea], Source={x:Static loc:Localization.Instance}}"/><TextBlock Grid.Column="1" Text="{Binding [TotalAreaLatium], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center"/><Slider x:Name="SldMinLatiumArea" Grid.Column="2" IsEnabled="{Binding IsChecked,ElementName=ChkMinLatiumArea}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" PreviewKeyDown="AreaSliderKeyDown" ValueChanged="AreaSliderValueChanged"/><TextBlock x:Name="LblMinLatiumArea" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button x:Name="BtnLatiumAreaMedian" Grid.Column="4" Content="Median" Click="SelectAreaMedian" Padding="7,3" Margin="8,0,0,0" ToolTip="{Binding [SetToRoundedMedian], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblLatiumAreaRange" Grid.Column="5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Slider x:Name="WgtLatiumArea" Grid.Column="6" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="56" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" ValueChanged="WeightSliderChanged" ToolTip="{Binding [WeightTooltip], Source={x:Static loc:Localization.Instance}}"/><TextBlock x:Name="LblWgtLatiumArea" Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Text="0" FontWeight="SemiBold" Visibility="Collapsed"/></Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="202"/><ColumnDefinition Width="240"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto" SharedSizeGroup="AreaRangeLabel"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
